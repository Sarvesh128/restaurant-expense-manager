# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Local MongoDB or MongoDB Atlas URI)
MONGODB_URI=mongodb://127.0.0.1:27017/restaurant_expense_ai

# JWT Security Configuration (Phase 3 Authentication)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Microservice Communications
AI_SERVICE_URL=http://localhost:8000

# Document Upload Configuration (Phase 5)
# Optional custom upload directory (defaults to backend/uploads/documents)
# UPLOAD_DIR=./uploads/documents
